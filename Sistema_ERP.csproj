<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Pagina_Central.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Pagina_Central.Designer.cs">
      <DependentUpon>Pagina_Central.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Pagina_Central.resx">
      <DependentUpon>Pagina_Central.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <None Update="connection.local.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
